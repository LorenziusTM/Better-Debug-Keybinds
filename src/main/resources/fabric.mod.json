{
	"schemaVersion": 1,
	"id": "betterdebugkeybinds",
	"version": "${version}",
	"name": "Better Debug Keybinds",
	"description": "Rebind Minecraft debug actions to independent client-side shortcuts.",
	"authors": [
		"Lorenzius"
	],
	"contact": {
		"sources": "https://github.com/LorenziusTM/Better-Debug-Keybinds"
	},
	"license": "CC0-1.0",
	"icon": "assets/betterdebugkeybinds/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.lorenzius.betterdebugkeybinds.client.BetterDebugKeybindsClient"
		]
	},
	"mixins": [
		{
			"config": "betterdebugkeybinds.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}